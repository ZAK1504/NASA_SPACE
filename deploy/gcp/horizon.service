[Unit]
Description=SPHEREx HORIZON FastAPI Backend Service
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=horizon
Group=horizon
WorkingDirectory=/opt/horizon/current/backend

# Load production configuration
EnvironmentFile=/etc/horizon/backend.env

# Execution command with virtualenv binary
ExecStart=/opt/horizon/current/backend/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1 --log-level info --proxy-headers --forwarded-allow-ips='127.0.0.1'

# Process restart policy
Restart=always
RestartSec=5s
TimeoutStopSec=20s

# Resource and file limits
LimitNOFILE=65535
LimitNPROC=4096

# Linux Kernel Hardening and Security Sandboxing
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictRealtime=true

# Persistent data directory access
ReadWritePaths=/srv/horizon-data /tmp /var/log/horizon

# Standard logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=horizon-backend

[Install]
WantedBy=multi-user.target
