# SPHEREx HORIZON — Production Backend Environment Configuration
# Target Location: /etc/horizon/backend.env (Permissions: 640, Owner: horizon:horizon)

# Application Environment
APP_ENV=production
LOG_LEVEL=INFO

# Networking & Local Binding (Managed behind Caddy reverse proxy)
HOST=127.0.0.1
PORT=8000
PUBLIC_BASE_URL=https://your-domain.com

# CORS Protection (In production, restrict to your verified domain)
ALLOWED_ORIGINS=https://your-domain.com

# Persistent Data Storage (Outside versioned application releases)
HORIZON_DATA_DIR=/srv/horizon-data
MPLCONFIGDIR=/tmp/matplotlib

# Resource Management for e2-standard-2 VM (2 vCPU, 8 GB RAM)
OMP_NUM_THREADS=2
MKL_NUM_THREADS=2
OPENBLAS_NUM_THREADS=2
NUMEXPR_NUM_THREADS=2

# Concurrency & Admission Control Limits
MAX_HEAVY_JOBS=1
MAX_PENDING_JOBS=5

# Disk & Cache Quotas
MAX_DOWNLOAD_BYTES=104857600
CACHE_MAX_BYTES=16106127360
REQUEST_TIMEOUT_SECONDS=30

# External Science Endpoints
IRSA_BASE_URL=https://irsa.ipac.caltech.edu
IRSA_TAP_URL=https://irsa.ipac.caltech.edu/TAP
